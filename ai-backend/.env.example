# Local development only. Never commit the real keys.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional CORS allow-list (comma separated). Leave empty to accept any origin.
# Example: ALLOWED_ORIGINS=https://bot-sand-mu-74.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# Automatic pipeline (POST /ai/webhook/message) — service-role Supabase access.
# Get both values from Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional shared secret for the webhook trigger. When set, bright-worker must
# send it in the `x-webhook-secret` header (set AI_BACKEND_WEBHOOK_SECRET in
# Supabase secrets to the same value).
WEBHOOK_SECRET=optional_shared_secret_here

# OpenRouter fallback provider — used ONLY when Gemini is temporarily
# unavailable (429/500/502/503/504/network/timeout, after one Gemini retry).
# The chain then tries FREE OpenRouter models sequentially (first success wins).
# Key stays server-side in this service's environment — never in the frontend.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional overrides (defaults shown). Free models are discovered dynamically
# through the public GET /models endpoint — pin the list only if you must.
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OPENROUTER_TIMEOUT_MS=30000
#OPENROUTER_MAX_MODELS=3
# Comma-separated explicit free model ids — skips dynamic discovery entirely.
#OPENROUTER_FREE_MODELS=

# Development/testing ONLY (server-side env; no client can set these):
# AI_TEST_PROVIDER='gemini' | 'openrouter' forces a single provider path;
# AI_TEST_MODEL pins the single OpenRouter model to try. Validation is NEVER
# bypassed in test mode. Leave both unset in production.
AI_TEST_PROVIDER=
AI_TEST_MODEL=
